# ElevenLabs — used ONLY by `npm run voices` (scripts/gen-voices.mjs) to
# pre-render the NSDR body-scan + N-Back letter audio. NOT needed at runtime.
# Copy to `.env` and fill in a real key; `.env` is gitignored — never commit a key.
ELEVENLABS_API_KEY=sk_your_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2
